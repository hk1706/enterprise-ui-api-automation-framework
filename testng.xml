<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Suite"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test name="Login Test 1">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="Login Test 2">
        <classes>
            <class name="tests.AdminTest"/>
        </classes>
    </test>

</suite>